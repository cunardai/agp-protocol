{
  "$id": "https://agp.dev/schema/objects/capability-token.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityToken",
  "type": "object",
  "required": [
    "type",
    "capability_id",
    "subject_agent",
    "issuer",
    "principal_id",
    "permitted_actions",
    "constraints",
    "expires_at",
    "revocation_id"
  ],
  "properties": {
    "type": { "const": "CapabilityToken" },
    "capability_id": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "subject_agent": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "issuer": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "principal_id": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "permitted_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "tool_scopes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "data_scopes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "spend_limit": {
          "$ref": "https://agp.dev/schema/common/defs.json#/$defs/currencyAmount"
        },
        "max_delegation_depth": {
          "type": "integer",
          "minimum": 0
        },
        "jurisdictions": {
          "type": "array",
          "items": { "type": "string", "minLength": 2, "maxLength": 16 }
        }
      },
      "additionalProperties": false
    },
    "expires_at": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/timestamp" },
    "revocation_id": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "signature": {
      "anyOf": [
        { "$ref": "https://agp.dev/schema/common/signature.json" },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}