{
  "$id": "https://agp.dev/schema/objects/delegation-chain.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelegationChain",
  "type": "object",
  "required": [
    "type",
    "delegation_id",
    "root_principal",
    "delegator_agent",
    "delegate_agent",
    "authority_scope",
    "constraints",
    "accepted_at",
    "expires_at",
    "signature_chain"
  ],
  "properties": {
    "type": { "const": "DelegationChain" },
    "delegation_id": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "parent_delegation_id": {
      "anyOf": [
        { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
        { "type": "null" }
      ]
    },
    "root_principal": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "delegator_agent": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "delegate_agent": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "authority_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "spend_limit": {
          "$ref": "https://agp.dev/schema/common/defs.json#/$defs/currencyAmount"
        },
        "max_hops_remaining": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "accepted_at": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/timestamp" },
    "expires_at": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/timestamp" },
    "signature_chain": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}