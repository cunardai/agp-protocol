{
  "$id": "https://agp.dev/schema/objects/evidence-bundle.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceBundle",
  "type": "object",
  "required": [
    "type",
    "bundle_id",
    "task_id",
    "claims",
    "created_at"
  ],
  "properties": {
    "type": { "const": "EvidenceBundle" },
    "bundle_id": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "task_id": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim_text",
          "source_refs",
          "verification_status",
          "corroboration_level",
          "fresh_until"
        ],
        "properties": {
          "claim_id": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
          "claim_text": { "type": "string", "minLength": 1 },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" }
          },
          "verification_status": {
            "$ref": "https://agp.dev/schema/common/defs.json#/$defs/verificationStatus"
          },
          "corroboration_level": {
            "type": "integer",
            "minimum": 0
          },
          "fresh_until": {
            "$ref": "https://agp.dev/schema/common/defs.json#/$defs/timestamp"
          }
        },
        "additionalProperties": false
      }
    },
    "created_at": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/timestamp" },
    "signature": {
      "anyOf": [
        { "$ref": "https://agp.dev/schema/common/signature.json" },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}