{
  "$id": "https://agp.dev/schema/objects/impact-assessment.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImpactAssessment",
  "description": "Pre-execution consequence simulation produced by an impact_assessor agent. Must be linked from the DecisionRecord for high and critical risk actions. Covers time horizons, stakeholder effects, Pareto analysis, and a recommendation. See AGP Profile §22.",
  "type": "object",
  "required": [
    "type",
    "assessment_id",
    "task_id",
    "decision_ref",
    "agent_id",
    "time_horizons",
    "recommendation",
    "assessed_at"
  ],
  "properties": {
    "type": { "const": "ImpactAssessment" },
    "assessment_id": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "task_id": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "decision_ref": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "agent_id": {
      "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id",
      "description": "Identity of the impact_assessor agent that produced this assessment"
    },
    "time_horizons": {
      "type": "array",
      "minItems": 1,
      "description": "Consequence projections across time horizons. High/critical risk actions must cover at least short_term and medium_term.",
      "items": {
        "type": "object",
        "required": ["horizon", "consequences", "severity", "reversible"],
        "properties": {
          "horizon": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/impactHorizon" },
          "consequences": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "severity": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/impactSeverity" },
          "reversible": {
            "type": "boolean",
            "description": "Whether the consequences can be undone if the action is later revoked"
          }
        },
        "additionalProperties": false
      }
    },
    "stakeholders_affected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stakeholder_class", "impact_direction", "magnitude"],
        "properties": {
          "stakeholder_class": {
            "type": "string",
            "minLength": 1,
            "description": "Class of affected party (e.g. end_user, third_party, regulator, counterparty)"
          },
          "impact_direction": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/impactDirection" },
          "magnitude": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/impactSeverity" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "pareto_assessment": {
      "type": "object",
      "required": ["improves_without_harm"],
      "description": "Pareto constraint check: does the action make at least one party better off without making any party worse off?",
      "properties": {
        "improves_without_harm": { "type": "boolean" },
        "harmed_parties": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "mitigation_available": {
          "type": "boolean",
          "description": "Whether mitigations exist that would restore Pareto optimality"
        },
        "mitigation_notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ethical_framework_applied": {
      "$ref": "https://agp.dev/schema/common/defs.json#/$defs/ethicalFramework"
    },
    "recommendation": {
      "type": "string",
      "enum": ["proceed", "proceed_with_caution", "require_human_review", "block"],
      "description": "The impact assessor's recommendation. Does not override policy — informs it."
    },
    "recommendation_rationale": {
      "type": "string",
      "description": "Plain-language justification for the recommendation"
    },
    "assessed_at": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/timestamp" },
    "signature": {
      "anyOf": [
        { "$ref": "https://agp.dev/schema/common/signature.json" },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}
