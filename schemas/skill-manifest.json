{
  "$id": "https://agp.dev/schema/objects/skill-manifest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillManifest",
  "type": "object",
  "required": [
    "type",
    "skill_id",
    "name",
    "version",
    "publisher",
    "supported_protocols",
    "skill_class",
    "risk_class",
    "instruction_hash",
    "attestation_level",
    "created_at"
  ],
  "properties": {
    "type": { "const": "SkillManifest" },
    "skill_id": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "publisher": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/id" },
    "supported_protocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["AGP", "A2A", "MCP", "UCP", "AP2"]
      }
    },
    "skill_class": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/skillClass" },
    "risk_class": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/riskTier" },
    "instruction_hash": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/hash" },
    "required_tools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "required_approvals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "attestation_level": {
      "$ref": "https://agp.dev/schema/common/defs.json#/$defs/attestationLevel"
    },
    "ethical_framework": {
      "anyOf": [
        { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/ethicalFramework" },
        { "type": "null" }
      ],
      "description": "The ethical framework this skill operates under. Required when risk_class is high or critical. See §24."
    },
    "created_at": { "$ref": "https://agp.dev/schema/common/defs.json#/$defs/timestamp" },
    "signature": {
      "anyOf": [
        { "$ref": "https://agp.dev/schema/common/signature.json" },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}